# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line

############################################################
# RC CORNERS
############################################################

create_rc_corner -name rc_best \
-T {-40} \
-preRoute_res {1.0} \
-preRoute_cap {1.0} \
-preRoute_clkres {0.0} \
-preRoute_clkcap {0.0} \
-postRoute_res {1.0} \
-postRoute_cap {1.0} \
-postRoute_xcap {1.0} \
-postRoute_clkres {0.0} \
-postRoute_clkcap {0.0}

create_rc_corner -name rc_worst \
-T {-40} \
-preRoute_res {1.0} \
-preRoute_cap {1.0} \
-preRoute_clkres {0.0} \
-preRoute_clkcap {0.0} \
-postRoute_res {1.0} \
-postRoute_cap {1.0} \
-postRoute_xcap {1.0} \
-postRoute_clkres {0.0} \
-postRoute_clkcap {0.0}

############################################################
# OPERATING CONDITIONS
############################################################

create_op_cond -name opcond_best \
-library_file {/run/media/ccoew/_DATA/cadence/SCLPDK_V3.0_KIT/scl180/stdcell/fs120/6M1L/liberty/lib_flow_ff/tsl18fs120_scl_ff.lib} \
-P {1.0} \
-V {1.98} \
-T {-40}

create_op_cond -name opcond_worst \
-library_file {/run/media/ccoew/_DATA/cadence/SCLPDK_V3.0_KIT/scl180/stdcell/fs120/6M1L/liberty/lib_flow_ss/tsl18fs120_scl_ss.lib } \
-P {1.0} \
-V {1.64} \
-T {125}

############################################################
# LIBRARY SETS
############################################################

create_library_set -name max_timing \
-timing {
    /run/media/ccoew/_DATA/cadence/SCLPDK_V3.0_KIT/scl180/stdcell/fs120/6M1L/liberty/lib_flow_ss/tsl18fs120_scl_ss.lib 
    /run/media/ccoew/_DATA/cadence/SCLPDK_V3.0_KIT/scl180/iopad/cio150/6M1L/liberty/tsl18cio150_max.lib 
}

create_library_set -name min_timing \
-timing {
    /run/media/ccoew/_DATA/cadence/SCLPDK_V3.0_KIT/scl180/stdcell/fs120/6M1L/liberty/lib_flow_ff/tsl18fs120_scl_ff.lib
    /run/media/ccoew/_DATA/cadence/SCLPDK_V3.0_KIT/scl180/iopad/cio150/6M1L/liberty/tsl18cio150_min.lib
}

############################################################
# CONSTRAINT MODE
############################################################

create_constraint_mode -name all \
-sdc_files {/run/media/ccoew/_DATA/cadence/Viterbi_Decoder/Inputs/viterbi_constarint.sdc}
############################################################
# DELAY CORNERS
############################################################

create_delay_corner -name max_delay \
-rc_corner {rc_worst} \
-early_library_set {min_timing} \
-late_library_set {max_timing} \
-early_opcond_library {tsl18fs120_scl_ff} \
-late_opcond_library {tsl18fs120_scl_ss} \
-early_opcond {opcond_best} \
-late_opcond {opcond_worst}

create_delay_corner -name min_delay \
-rc_corner {rc_best} \
-early_library_set {min_timing} \
-late_library_set {max_timing} \
-early_opcond_library {tsl18fs120_scl_ff} \
-late_opcond_library {tsl18fs120_scl_ss} \
-early_opcond {opcond_best} \
-late_opcond {opcond_worst}

############################################################
# ANALYSIS VIEWS
############################################################

create_analysis_view -name worst \
-constraint_mode {all} \
-delay_corner {max_delay}

create_analysis_view -name best \
-constraint_mode {all} \
-delay_corner {min_delay}

############################################################
# SET ANALYSIS VIEW
############################################################

set_analysis_view -setup {worst} -hold {best}
